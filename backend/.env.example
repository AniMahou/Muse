# ============================================================================
# Muse — backend environment
#
# Copy to `.env` and fill in. Every provider below has a free tier that does
# NOT require a credit card. See docs/MANUAL_SETUP.md for how to obtain each
# key step by step.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list, or * in development
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Datastores  (both started by `npm run dev:infra` at the repo root)
#
# NON-DEFAULT PORTS ON PURPOSE. 27017 and 6379 are frequently already taken by
# another project on the same machine, and pointing here at a stranger's
# database is a silent failure rather than a loud one.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27018
MONGO_DB=muse
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# ASR — speech to text                                        [STAGE 1]
#
# ASR_PROVIDER: groq | gemini | local | fake
#
#   groq   — RECOMMENDED. whisper-large-v3. Free API key, no credit card.
#            https://console.groq.com  → API Keys
#            Free tier is ~2,000 audio requests/day, 30 req/min.
#
#   gemini — Gemini Flash accepts audio natively. Free via AI Studio, no card.
#            https://aistudio.google.com/apikey
#            NOTE: on the free tier Google may use submitted data to improve
#            their products. Fine for development; do NOT send real customer
#            field audio through it.
#
#   local  — whisper.cpp on this machine. No key, no network, no limits.
#            Slower, but field audio never leaves your infrastructure — this
#            is the mode to demo when an enterprise asks about data residency.
#
#   fake   — replays committed fixtures. Used by all tier 0/1/3 tests.
# ---------------------------------------------------------------------------
ASR_PROVIDER=fake

GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.0-flash

# Only used when ASR_PROVIDER=local
WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_CPP_MODEL=/opt/homebrew/share/whisper-cpp/ggml-large-v3.bin

# ISO 639-1. Forcing the language materially improves Bangla accuracy over
# letting the model auto-detect.
ASR_LANGUAGE=bn

# ---------------------------------------------------------------------------
# LLM — assembly                                              [STAGE 5]
#
# LLM_PROVIDER: groq | gemini | fake
# Must support structured output / JSON schema mode.
# ---------------------------------------------------------------------------
LLM_PROVIDER=fake

GROQ_LLM_MODEL=openai/gpt-oss-120b
GEMINI_LLM_MODEL=gemini-2.0-flash

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Storage — raw audio                                         [STAGE 0]
#
# STORAGE_DRIVER: local | s3
# `local` is correct for development and for the demo. 100 clips is ~4 MB.
# The s3 adapter is a stub; the port exists so swapping later is one file.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Pipeline tuning
# ---------------------------------------------------------------------------

# A field below this confidence is flagged for clarification.
CONFIDENCE_THRESHOLD=0.80

# Fields whose uncertainty is worth interrupting a rep over. Everything else
# is allowed through flagged but unconfirmed.
CRITICAL_FIELDS=outlet_id,sku,quantity,competitor_brand

# Candidate generation
SKU_MATCH_MIN_SCORE=0.55
SKU_MAX_CANDIDATES=5
OUTLET_RADIUS_M=120
OUTLET_MAX_CANDIDATES=5

# Hours before an unanswered clarification auto-resolves to the best guess.
CLARIFICATION_TIMEOUT_HOURS=24

# ---------------------------------------------------------------------------
# Developer tooling
# ---------------------------------------------------------------------------

# Per-clip, per-stage I/O dumps to backend/traces/. Invaluable for bisecting
# which stage broke. Leave on in development.
TRACE_ENABLED=true
TRACE_DIR=./traces

# Content-addressed stage cache. Editing stage 6 then re-running the eval
# re-executes only stage 6 — ASR and LLM results are reused.
STAGE_CACHE_ENABLED=true
STAGE_CACHE_DIR=./.cache/stages

# Validate every stage's input and output against its Zod schema. Catches a
# contract violation at the seam instead of three stages downstream.
# Costs a little performance; keep true in development, false in production.
VALIDATE_STAGE_IO=true

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
QUEUE_PREFIX=muse
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
