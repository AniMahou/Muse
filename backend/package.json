{
  "name": "@muse/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,green \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src eval tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:cov": "vitest run --coverage",
    "eval": "tsx eval/run.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "crib": "tsx scripts/crib.ts",
    "mic": "tsx scripts/mic.ts",
    "collect": "tsx scripts/collect.ts",
    "clips": "tsx scripts/clips-audit.ts",
    "labels:build": "tsx scripts/labels-build.ts",
    "labels:scaffold": "tsx scripts/labels-build.ts --scaffold",
    "labels:check": "tsx scripts/labels-build.ts --check",
    "view:trace": "tsx scripts/view-trace.ts",
    "try": "tsx scripts/try-clip.ts",
    "record": "bash scripts/record.sh"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
